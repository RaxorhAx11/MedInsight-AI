# ============================================================
# MedInsight AI — Server Environment Variables
# ============================================================
# Copy this file to server/.env and fill in actual values.
# Never commit the actual .env file to version control.
# ============================================================

# Application Environment
# Set to "production" for live deployments. Changes logging format,
# serves the React build, and enforces CLIENT_URL requirement.
NODE_ENV=development

# Server Port
# The port the Express server will listen on.
PORT=8080

# ============================================================
# DATABASE — REQUIRED
# ============================================================

# MongoDB Connection URI — REQUIRED
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017/<dbname>
MONGODB_URI=mongodb://localhost:27017/medinsight

# MongoDB Connection Pool — Maximum concurrent DB connections.
MONGODB_MAX_POOL_SIZE=10

# MongoDB Server Selection Timeout — How long to wait for a primary (in ms).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# MongoDB Socket Timeout — Inactivity timeout for open connections (in ms).
MONGODB_SOCKET_TIMEOUT_MS=45000

# MongoDB Auto Index — Set to "false" in production to avoid startup overhead.
# Mongoose will not automatically build indexes; manage them in Atlas or migration scripts.
MONGODB_AUTO_INDEX=true

# MongoDB Retry Attempts — Number of times to retry connecting on startup failure.
MONGODB_RETRY_ATTEMPTS=5

# MongoDB Retry Delay — Milliseconds to wait between each retry attempt.
MONGODB_RETRY_DELAY_MS=5000

# ============================================================
# AUTHENTICATION — REQUIRED
# ============================================================

# JWT Private Key — REQUIRED
# Secret used to sign JWT tokens. Use a long, random string.
# Generate one with: openssl rand -base64 64
JWTPRIVATEKEY=replace_with_a_long_random_secret_key

# JWT Expiration — How long tokens remain valid before requiring re-login.
JWT_EXPIRATION=7d

# bcrypt Salt Rounds — Cost factor for password hashing.
# Higher = more secure but slower. 10–12 is typical for production.
SALT=10

# ============================================================
# AI SERVICE — REQUIRED
# ============================================================

# Google Gemini API Key — REQUIRED
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key

# ============================================================
# CORS — REQUIRED IN PRODUCTION
# ============================================================

# Client URL — REQUIRED in production
# The public URL(s) of the React frontend. Used for CORS origin whitelist.
# Separate multiple origins with a comma (no spaces).
# Example: https://yourdomain.com,https://www.yourdomain.com
CLIENT_URL=http://localhost:3000

# ============================================================
# CLOUD STORAGE — OPTIONAL (Cloudinary)
# ============================================================
# If not configured, files are saved locally to server/uploads/.
# Local storage is NOT recommended for production deployments.
# Obtain credentials from: https://cloudinary.com/console

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================================
# LOGGING — OPTIONAL
# ============================================================

# Log Level — Controls minimum severity of logged messages.
# Options: error, warn, info, http, verbose, debug, silly
# Default: info
LOG_LEVEL=info

# Override Console — If "true", routes all console.* calls through Winston.
# Automatically set to true when NODE_ENV=production.
OVERRIDE_CONSOLE=false
